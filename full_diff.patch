+  void nsHttpHandler::RemoveCredential(const nsACString& url){
+    nsCOMPtr<nsIURI> uri;
+    NS_NewURI(getter_AddRefs(uri), url);
+    nsCString host;
+    uri->GetAsciiHost(host);
