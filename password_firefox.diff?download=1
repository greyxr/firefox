+    }
+    if (unbuffered instanceof Ci.nsIMultiplexInputStream) {
+        for (let i = 0; i < unbuffered.count; i++) {
+            yield unbuffered.getStream(i);
+        }
+    } else {
+        yield outerStream;
+    }
