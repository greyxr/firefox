+        for (let chunk of readAllStrings(stream)) {
+            chunk = tail + chunk;
+            let parts = chunk.split(boundary);
+            tail = parts.pop();
+            yield* parts;
+        }
+        if (tail) {
+            yield tail;
+        }
+    }
